{
  "name": "illustrator-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "format": "prettier --write . && eslint --fix \"src/**/*.{js,jsx}\" ; stylelint --fix \"src/**/*.css\"",
    "format:check": "prettier --check . && eslint \"src/**/*.{js,jsx}\" ; stylelint \"src/**/*.css\"",
    "lint": "eslint \"src/**/*.{js,jsx}\" ; stylelint \"src/**/*.css\""
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "eslint-plugin-react": "^7.37.3",
    "globals": "^15.14.0",
    "prettier": "^3.9.10",
    "stylelint": "^16.12.0",
    "stylelint-config-standard": "^36.0.1",
    "stylelint-prettier": "^5.0.2",
    "vite": "^6.0.5"
  },
  "description": "Векторный редактор композиций из исходной библиотеки SVG-компонентов",
  "engines": {
    "node": ">=18"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "fsevents@2.3.3": true
  }
}
